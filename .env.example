# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Token seguro do bot Telegram gerado pelo @BotFather.
# Gerenciado estritamente no backend (server.ts / .env) para prevenir vazamento no navegador.
TELEGRAM_BOT_TOKEN=""

# CMC_API_KEY: opcional. Sem ela, o top 100 vem do CoinGecko (mesmo ranking por market cap).
CMC_API_KEY=""

# TELEGRAM_CHAT_ID: destino dos alertas automáticos de sinais (chat numérico ou @canal).
TELEGRAM_CHAT_ID=""

# SCAN_INTERVAL_MINUTES: intervalo da varredura (padrão 5). SCANNER_ENABLED=false desliga.
SCAN_INTERVAL_MINUTES=5

# EXCHANGES: corretoras em que o par USDT precisa existir (padrão: binance,bybit). Os candles vêm da Binance.
EXCHANGES=binance,bybit

# MARKET_MODE: spot (padrão) ou futures. Em spot, VENDA = sair de posição já existente; backtest só com compras.
MARKET_MODE=spot
