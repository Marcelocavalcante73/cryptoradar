# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Token seguro do bot Telegram gerado pelo @BotFather.
# Gerenciado estritamente no backend (server.ts / .env) para prevenir vazamento no navegador.
TELEGRAM_BOT_TOKEN=""

# CMC_API_KEY: opcional. Sem ela, o top 100 vem do CoinGecko (mesmo ranking por market cap).
CMC_API_KEY=""

# TELEGRAM_CHAT_ID: destino dos alertas automáticos de sinais (chat numérico ou @canal).
TELEGRAM_CHAT_ID=""

# SCAN_INTERVAL_MINUTES: intervalo da varredura (padrão 5). SCANNER_ENABLED=false desliga.
SCAN_INTERVAL_MINUTES=5

# EXCHANGES: corretora(s) exigida(s) para o universo (padrão: binance).
EXCHANGES=binance

# FUTURES_ENABLED: scanner de futuros (perpétuos USDT-M da Binance). Use false para desligar.
FUTURES_ENABLED=true

# TREND_ENABLED: scanner diário da estratégia de rompimento de 55 dias (aba Tendência). Use false para desligar.
TREND_ENABLED=true

# --- Armazenamento e acesso (veja DEPLOY.md) ---
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY: guardam carteira, histórico e sinais de forma permanente (rode supabase/schema.sql).
# Sem eles o servidor usa arquivo em disco, que some ao reiniciar em hospedagens gratuitas.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# APP_ACCESS_KEY: chave de acesso. Sem ela, qualquer pessoa com o link vê e altera a sua carteira.
APP_ACCESS_KEY=""

# PERSISTENT_DISK=true se o seu servidor tem disco persistente (só vale para o armazenamento em arquivo).
PERSISTENT_DISK=false

# --- Análise com IA (opcional): só EXPLICA e RESUME os sinais, não cria sinal nem prevê preço ---
# Use a GEMINI_API_KEY acima (o AI Studio já injeta) ou OPENAI_API_KEY (ChatGPT). Sem chave, os botões "Explicar" não aparecem.
OPENAI_API_KEY=""
# AI_PROVIDER: gemini | openai (padrão: o que tiver chave, Gemini primeiro). AI_MODEL: padrão gemini-2.5-flash / gpt-4o-mini.
AI_PROVIDER=""
AI_MODEL=""
# AI_DAILY_LIMIT: máximo de chamadas à IA por dia (padrão 150), para limitar custo.
AI_DAILY_LIMIT=150
